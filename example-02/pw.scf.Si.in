 &CONTROL
   calculation  = 'scf'
   outdir       = './si'
   prefix       = 'si'
   pseudo_dir   = '../pseudo'
   restart_mode = 'from_scratch'
 /

 &SYSTEM
   celldm(1) = 10.2
   ecutrho   = 72.0
   ecutwfc   = 18.0
   ibrav     = 2
   nat       = 2
   ntyp      = 1
 /

 &ELECTRONS
   conv_thr = 1e-7
 /

ATOMIC_SPECIES 
    Si  1.0  Si.pz-vbc.UPF

ATOMIC_POSITIONS alat
  Si       0.000000000000   0.000000000000   0.000000000000
  Si       0.250000000000   0.250000000000   0.250000000000

K_POINTS automatic
  4   4   4   1   1   1 



